diff --git a/media_platform/douyin/login.py b/media_platform/douyin/login.py
index 4b76d11..1dae758 100644
--- a/media_platform/douyin/login.py
+++ b/media_platform/douyin/login.py
@@ -116,9 +116,25 @@ class DouYinLogin(AbstractLogin):
             await self.context_page.wait_for_selector(dialog_selector, timeout=1000 * 10)
         except Exception as e:
             utils.logger.error(f"[DouYinLogin.popup_login_dialog] login dialog box does not pop up automatically, error: {e}")
+            # douyin re-renders the login overlay under another id
+            # (login-full-panel-*) which can break the wait above; if any
+            # overlay is already visible the QR is up - clicking the
+            # underlying button would only be intercepted by the overlay
+            try:
+                overlay_visible = await self.context_page.locator(
+                    "xpath=//div[@id='login-panel-new'] | //div[starts-with(@id,'login-full-panel')]"
+                ).first.is_visible()
+            except Exception:
+                overlay_visible = False
+            if overlay_visible:
+                utils.logger.info("[DouYinLogin.popup_login_dialog] login overlay already visible, skip manual click")
+                return
             utils.logger.info("[DouYinLogin.popup_login_dialog] login dialog box does not pop up automatically, we will manually click the login button")
             login_button_ele = self.context_page.locator("xpath=//p[text() = '登录']")
-            await login_button_ele.click()
+            try:
+                await login_button_ele.click()
+            except Exception as click_err:
+                utils.logger.warning(f"[DouYinLogin.popup_login_dialog] manual login button click failed, continue: {click_err}")
             await asyncio.sleep(0.5)
 
     async def login_by_qrcode(self):
