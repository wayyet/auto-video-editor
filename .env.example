# Local EDB Postgres 16.11 in Docker
POSTGRES_URI=postgresql://postgres:devpass@localhost:5432/langgraph

# Use Postgres explicitly. Leave unset to keep the SQLite default.
# CHECKPOINTER_BACKEND=postgres

# =========================================================================
# Phase 1 — FireRed-OpenStoryline MCP 集成(plan §7.2 / ADR-001 / ADR-005)
# --------------------------------------------------------------------------
# FireRed 仓库根目录(影响 config.toml 加载与 config.py default_config_path())
# 默认值:同机的 FireRed-OpenStoryline 仓库;按实际路径修改
FIRERED_ROOT=E:\Documents\kuaishou\FireRed-OpenStoryline

# FireRed 自带 Python 3.11 环境可执行;未配时走 PATH 上的 python(开发期)
# 推荐用 conda env storyline 的 python.exe 形式
# FIRERED_PYTHON=C:\Users\wayyet\.conda\envs\storyline\python.exe
FIRERED_PYTHON=python

# MCP 传输方式:stdio(开发期,主项目负责 spawn 子进程) / streamable-http(生产期,常驻)
STORYLINE_MCP_TRANSPORT=stdio

# 仅 streamable-http 用;对应 FireRed config.toml 的 [local_mcp_server] port=8001 + path=/mcp
# STORYLINE_MCP_URL=http://127.0.0.1:8001/mcp

# AI Transition(ADR-005 默认关闭,=0/=false);开启后把
# generate_ai_transition / plan_timeline_ai_transition 加入 capability 检查
STORYLINE_ENABLE_AI_TRANSITION=0

# 单次 MCP call_tool 超时(秒),与 FireRed config.toml timeout=600 对齐
STORYLINE_TOOL_TIMEOUT_S=600

# MCP initialize / list_tools 重试次数
STORYLINE_CONNECT_RETRIES=3

# outputs/{job_id}/ 根目录(默认 cwd 下的 outputs)
# AUTO_VIDEO_EDITOR_OUTPUTS_ROOT=E:\Documents\kuaishou\auto-video-editor\outputs