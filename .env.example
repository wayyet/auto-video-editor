# 环境变量样例(复制为 .env 或直接注入进程环境;真实密钥不入库)。
# 2026-11-04 单流水线收敛后,FireRed-OpenStoryline MCP 集成与旧聊天运行时
# 相关变量(FIRERED_ROOT / FIRERED_PYTHON / STORYLINE_MCP_TRANSPORT /
# STORYLINE_MCP_URL / STORYLINE_TOOL_TIMEOUT_S / STORYLINE_CONNECT_RETRIES)
# 已随调用代码一并删除,不再列出。

# Local EDB Postgres 16.11 in Docker(唯一数据库;agent_gate 侧优先读
# AGENT_GATE_POSTGRES_URI,回退本变量)
POSTGRES_URI=postgresql://postgres:devpass@localhost:5432/video_workflow

# =========================================================================
# 2026-10 接入原"不可达节点"的三个开关(默认全开;设为 0 即关闭)
# 三个都设为 0 ⇒ 图的执行轨迹与接入前完全一致(回滚开关)。
# --------------------------------------------------------------------------
# auto 模式:素材加载后并行搜网页话题,标题作为"外部参考"软注入文案节点(需要 storyline_targets.query)
STORYLINE_ENABLE_WEB_TOPIC=1

# auto 模式:切镜后若素材有音轨,并行跑本地 ASR + 口播粗剪,结果只回填 Clip.transcript。
# 本地化 ASR 仅支持 STORYLINE_ASR_MODE=stub(转写为空,无可见变化;vendored 子进程
# 模式已随旧聊天运行时删除),真实转写见 storyline_capabilities/asr_runner.py 头注。
STORYLINE_ENABLE_ASR_BRANCH=1

# auto 模式:与 plan_timeline_pro 并排生成 AI 转场清单,在 qa_gate 之前挂到时间线 ai_transitions
# (当前只有 stub 客户端;不改 clips / 总时长)。ADR-005 原为默认关闭,2026-10 按决定改为默认开启。
# ⚠️ 这个开关在**建图时**读取:修改后必须重启进程才生效(前两个开关是运行时读取)。
# 注意:config.py 与 storyline_capabilities/ai_transition_client.py 各读一次,默认值必须一致。
STORYLINE_ENABLE_AI_TRANSITION=1

# outputs/{job_id}/ 根目录(默认 cwd 下的 outputs)
# AUTO_VIDEO_EDITOR_OUTPUTS_ROOT=E:\Documents\kuaishou\auto-video-editor\outputs
