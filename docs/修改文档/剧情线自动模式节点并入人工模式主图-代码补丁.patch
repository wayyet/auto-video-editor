+"""human 模式融合:侧支包装(nodes/storyline/fusion.py)的单元测试。
+
+覆盖:规格表完整性、挂载数上限、白名单、缺前置跳过、异常隔离、产物目录隔离、
+重命名发布(不覆盖 human 主图字段)、最终时间线选择、QA 标签改名、禁用开关。
+"""
+from __future__ import annotations
